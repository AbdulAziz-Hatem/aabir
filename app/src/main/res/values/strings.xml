    <string name="onboarding_step1_title">Welcome to NetPass</string>
    <string name="onboarding_step1_subtitle">Cross into your network in a blink</string>
    <string name="onboarding_step1_desc">A free and open-source (FOSS) Android app built natively with Kotlin and Jetpack Compose, designed to empower blind users and screen-reader users (TalkBack / Jieshuo) to scan Wi-Fi vouchers and log in to MikroTik hotspots effortlessly.</string>
    <string name="onboarding_step2_badge">Adaptive Guided Vision</string>
    <string name="onboarding_step2_title">Smart Desk Guidance</string>
    <string name="onboarding_step2_subtitle">Instant directional cues with zero clutter</string>
    <string name="onboarding_step2_desc">Place the small Wi-Fi card on a flat surface and the phone guides your hand with short, clear cues (left, right, closer...) while protecting battery life. Once steady in the sweet spot, the code is captured automatically.</string>
    <string name="onboarding_step3_title">Permissions &amp; Fallbacks</string>
    <string name="onboarding_step3_subtitle">You are always in full control</string>
    <string name="permission_camera_granted">Camera permission granted</string>
    <string name="permission_camera_optional">Camera permission (optional for scanning)</string>
    <string name="permission_camera_privacy_note">The camera is used solely for offline on-device OCR. No images are ever stored or uploaded.</string>
    <string name="btn_grant_camera_permission">Grant Camera Permission Now</string>
    <string name="permission_fallback_note">Even if permission is denied now or later, all features continue working via manual entry or clipboard paste.</string>

